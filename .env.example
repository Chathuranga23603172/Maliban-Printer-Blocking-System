# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_PATH=./data/printer_tracking.db

# Cron Schedule for Deadline Check (Every Friday at 5:00 PM / 17:00)
CRON_SCHEDULE=0 17 * * 5

# PowerShell Remote Execution Configuration
SIMULATE_POWERSHELL=false
POWERSHELL_TIMEOUT_MS=15000
